# Local development paths. Docker uses /data/HHGOA instead.
HHGOA_DATA_DIR=/Users/adnaan/Downloads/HHGOA
HHGOA_GRAPH_BACKEND=tigergraph
HHGOA_GRAPH_CASES_PATH=/Users/adnaan/Downloads/HHGOA/runtime/cases.jsonl
HHGOA_MODEL=openrouter/free
HHGOA_EMBEDDING_MODEL=text-embedding-3-small
HHGOA_TIGERGRAPH_MCP_URL=http://localhost:8001/mcp/
HHGOA_TIGERGRAPH_GRAPH_NAME=HHGOAFraudGraph
HHGOA_READ_ONLY=true
# PostgreSQL is required for the durable API/worker deployment. Leave blank for
# the in-memory local test mode.
HHGOA_DATABASE_URL=

# Copy this template to .env and fill it locally. Never commit credentials.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Consumed by the TigerGraph MCP server, not the browser.
TG_HOST=
TG_GRAPHNAME=HHGOAFraudGraph
TG_TGCLOUD=true
TG_API_TOKEN=
TG_SECRET=
